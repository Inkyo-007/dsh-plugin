#!/bin/sh
# Regenerate the plugin market index before pushing main. If regeneration
# changed index.json, commit it automatically so the pushed history always
# carries an index pinned to the plugin commits it describes.
#
# Installed via `git config core.hooksPath .githooks`.

branch=$(git symbolic-ref --short HEAD 2>/dev/null) || exit 0
[ "$branch" = "main" ] || exit 0

if ! node scripts/build-index.mjs; then
  echo "pre-push: index generation failed; push aborted" >&2
  exit 1
fi

if [ -n "$(git status --porcelain index.json)" ]; then
  git add index.json
  git commit -m "chore(auto): update plugin index" || exit 1
  echo "pre-push: index.json changed; committed as $(git rev-parse --short HEAD)"
fi

exit 0
